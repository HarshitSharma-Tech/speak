# LearnSync AI Environment Variables Configuration

PROJECT_NAME=LearnSync AI
VERSION=1.0.0
API_V1_STR=/api/v1

# Database Configuration (SQLite default for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./learnsync.db
# DATABASE_URL=postgresql://user:password@localhost:5432/learnsync

# Storage directories
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./chroma_data

# AI Providers
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Operational Settings
MAX_UPLOAD_SIZE_MB=50
MOCK_AI_FALLBACK=true
